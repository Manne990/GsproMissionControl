<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GsproMissionControl.MainWindow"
        Title="GSPro - Mission Control"
        Icon="avares://GsproMissionControl/Assets/icon.ico"
        Width="1200" Height="700"
        Background="Black"
        ShowInTaskbar="False"
        ShowActivated="False"
>

  <Window.Styles>
    <Style Selector="Button, RepeatButton">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button, RepeatButton">
      <Setter Property="Background" Value="#2E2E2E"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="20"/>
    </Style>

    <Style Selector="Button:pointerover, RepeatButton:pointerover">
      <Setter Property="Background" Value="#2E2E2E"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button:pressed, RepeatButton:pressed">
      <Setter Property="Background" Value="#454545"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="RepeatButton.dpad">
      <Setter Property="Width" Value="138"/>
      <Setter Property="Height" Value="138"/>
      <Setter Property="FontSize" Value="50"/>
      <Setter Property="CornerRadius" Value="69"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
  </Window.Styles>

<Viewbox Stretch="Uniform">
        <Grid ColumnDefinitions="220,*,220"
                RowDefinitions="*"
                Margin="20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Black">

                <!-- LEFT COLUMN -->
                <StackPanel Grid.Column="0" Spacing="20" VerticalAlignment="Center">
                        <Button Content="FLYOVER" Click="Flyover_OnClick" Height="54" Width="180"/>
                        <Button Content="AIM" Click="Aim_OnClick" Height="54" Width="180"/>
                        <Button Content="HEAT MAP" Click="HeatMap_OnClick" Height="54" Width="180"/>
                        <Button Content="HIDE OBJ" Click="HideObjects_OnClick" Height="54" Width="180"/>
                        <Button Content="HIDE UI" Click="HideUi_OnClick" Height="54" Width="180"/>
                </StackPanel>

                <!-- MIDDLE COLUMN -->
                <Grid Grid.Column="1"
                        RowDefinitions="Auto,*,Auto,Auto"
                        ColumnDefinitions="*"
                        Margin="20,0"
                        Background="Black">

                        <!-- TITLE -->
                        <Label Grid.Row="0"
                                Content="GSPro - Mission Control"
                                Foreground="White"
                                FontFamily="avares://GsproMissionControl/Assets/Orbitron.ttf#Orbitron"
                                FontSize="22"
                                HorizontalAlignment="Center"/>

                        <!-- D-PAD -->
                        <Grid Grid.Row="1"
                                RowDefinitions="Auto,Auto,Auto"
                                ColumnDefinitions="Auto,Auto,Auto"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,20">

                                <!-- UP -->
                                <RepeatButton Grid.Row="0" Grid.Column="1"
                                                Classes="dpad"
                                                Content="↑"
                                                Interval="100"
                                                Click="CameraUp_OnClick"/>

                                <!-- LEFT -->
                                <RepeatButton Grid.Row="1" Grid.Column="0"
                                                Classes="dpad"
                                                Content="←"
                                                Interval="100"
                                                Click="CameraLeft_OnClick"/>

                                <!-- RIGHT -->
                                <RepeatButton Grid.Row="1" Grid.Column="2"
                                                Classes="dpad"
                                                Content="→"
                                                Interval="100"
                                                Click="CameraRight_OnClick"/>

                                <!-- DOWN -->
                                <RepeatButton Grid.Row="2" Grid.Column="1"
                                                Classes="dpad"
                                                Content="↓"
                                                Interval="100"
                                                Click="CameraDown_OnClick"/>
                        </Grid>

                        <!-- TEE -->
                        <Grid Grid.Row="2"
                                ColumnDefinitions="Auto,Auto"
                                HorizontalAlignment="Center"
                                Margin="0,10"
                                Width="360">

                                <Button Grid.Column="0"
                                        Content="←  TEE"
                                        Width="170" Height="54"
                                        Margin="0,0,20,0"
                                        Click="TeeBack_OnClick"/>

                                <Button Grid.Column="1"
                                        Content="TEE  →"
                                        Width="170" Height="54"
                                        Click="TeeForward_OnClick"/>
                        </Grid>

                        <!-- SCORE CARD -->
                        <Button Grid.Row="3"
                                Content="SCORE CARD"
                                Height="54"
                                Width="360"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0"
                                Click="ScoreCard_OnClick"/>
                </Grid>

                <!-- RIGHT COLUMN -->
                <StackPanel Grid.Column="2" Spacing="20" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Content="CLUB  ↑" Height="54" Width="180" Click="ClubUp_OnClick"/>
                        <Button Content="CLUB  ↓" Height="54" Width="180" Click="ClubDown_OnClick"/>
                        <Button Content="PUTTER" Height="54" Width="180" Click="Putter_OnClick"/>
                </StackPanel>

        </Grid>
</Viewbox>
</Window>