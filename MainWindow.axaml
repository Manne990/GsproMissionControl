<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GsproMissionControl.MainWindow"
        Title="GSPro - Mission Control"
        Width="1200" Height="700">

<!-- Grundlayout: 3 kolumner -->
<Grid ColumnDefinitions="220,*,220"
        RowDefinitions="*"
        Margin="20"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

        <!-- VÄNSTERKOLUMN -->
        <StackPanel Grid.Column="0" Spacing="14" VerticalAlignment="Center">
                <Button Content="FLYOVER" Click="Flyover_OnClick" Height="54"/>
                <Button Content="AIM" Click="Aim_OnClick" Height="54"/>
                <Button Content="HEAT MAP" Click="HeatMap_OnClick" Height="54"/>
                <Button Content="HIDE OBJ" Click="HideObjects_OnClick" Height="54"/>
                <Button Content="HIDE UI" Click="HideUi_OnClick" Height="54"/>
        </StackPanel>

        <!-- MITTENKOLUMN -->
        <Grid Grid.Column="1"
                RowDefinitions="Auto,*,Auto,Auto"
                ColumnDefinitions="*"
                Margin="20,0">

                <!-- SHORTCUTS -->
                <Label Grid.Row="0"
                        Content="GSPro"
                        HorizontalAlignment="Center"/>

                <!-- D-PAD + tee-knappar (i samma område) -->
                <Grid Grid.Row="1"
                        RowDefinitions="Auto,Auto,Auto"
                        ColumnDefinitions="Auto,Auto,Auto"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,20">

                        <!-- Upp -->
                        <RepeatButton Grid.Row="0" Grid.Column="1"
                                        Content="↑"
                                        FontSize="26"
                                        Width="110" Height="110"
                                        Interval="100"
                                        Click="CameraUp_OnClick"/>

                        <!-- Vänster -->
                        <RepeatButton Grid.Row="1" Grid.Column="0"
                                        Content="←"
                                        FontSize="26"
                                        Width="110" Height="110"
                                        Interval="100"
                                        Click="CameraLeft_OnClick"/>

                        <!-- Höger -->
                        <RepeatButton Grid.Row="1" Grid.Column="2"
                                        Content="→"
                                        FontSize="26"
                                        Width="110" Height="110"
                                        Interval="100"
                                        Click="CameraRight_OnClick"/>

                        <!-- Ned -->
                        <RepeatButton Grid.Row="2" Grid.Column="1"
                                        Content="↓"
                                        FontSize="26"
                                        Width="110" Height="110"
                                        Interval="100"
                                        Click="CameraDown_OnClick"/>

                </Grid>

                <!-- TEE -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto" HorizontalAlignment="Center" Margin="0,10">
                        <Button Grid.Column="0" Content="←  TEE" Width="170" Height="54" Margin="0,0,20,0"
                                Click="TeeBack_OnClick"/>
                        <Button Grid.Column="1" Content="TEE  →" Width="170" Height="54"
                                Click="TeeForward_OnClick"/>
                </Grid>

                <!-- SCORE CARD -->
                <Button Grid.Row="3" Content="SCORE CARD" Height="60" HorizontalAlignment="Center" Width="520"
                        Margin="0,10,0,0" Click="ScoreCard_OnClick"/>
        </Grid>

        <!-- HÖGERKOLUMN -->
        <StackPanel Grid.Column="2" Spacing="14" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button Content="CLUB  ↑" Height="54" Width="180" Click="ClubUp_OnClick"/>
                <Button Content="CLUB  ↓" Height="54" Width="180" Click="ClubDown_OnClick"/>
                <Button Content="PUTTER" Height="54" Width="180" Click="Putter_OnClick"/>
        </StackPanel>
</Grid>
</Window>